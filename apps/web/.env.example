# Server-only URL used by the web application to call the AI service.
AI_SERVICE_URL=http://127.0.0.1:8000

# Development authentication. Replace the secret and credentials outside local use.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
DEV_AUTH_NAME=CadeBit Student
DEV_AUTH_EMAIL=student@cadebit.local
DEV_AUTH_PASSWORD=cadebit-local
