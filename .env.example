# CadeBit keeps runtime environment files beside each service.
#
# Copy the web template:
#   apps/web/.env.example -> apps/web/.env.local

# Server-only URL used by the web application to call the AI service.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=cadebit-local-ai-service-token
AI_SERVICE_TIMEOUT_MS=35000

# Private S3-compatible course-material storage.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cadebit-materials
S3_ACCESS_KEY=cadebit
S3_SECRET_KEY=cadebit-local-storage-secret
S3_FORCE_PATH_STYLE=true
MATERIAL_PIPELINE_VERSION=v1

# PostgreSQL and Better Auth. Replace the secret outside local development.
DATABASE_URL=postgresql://cadebit:cadebit@127.0.0.1:5432/cadebit
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

#
# Copy the AI service template:
#   services/ai/.env.example -> services/ai/.env.local

# Application mode: development, test, or production.
CADEBIT_ENVIRONMENT=development

# Local Uvicorn server settings.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=info

# Drizzle owns database migrations; the AI service only consumes this connection.
DATABASE_URL=postgresql://cadebit:cadebit@127.0.0.1:5432/cadebit

# Shared secret for calls from the web server. Use the same value in apps/web.
AI_SERVICE_TOKEN=cadebit-local-ai-service-token

# OpenAI Responses API configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.15
RAG_MAX_CONTEXT_CHARACTERS=16000
INGESTION_WORKER_POLL_SECONDS=2
INGESTION_WORKER_LEASE_SECONDS=600
INGESTION_RETRY_BASE_SECONDS=5
