# Application mode: development, test, or production.
CADEBIT_ENVIRONMENT=development

# Local Uvicorn server settings.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=info

# Drizzle owns database migrations; the AI service only consumes this connection.
DATABASE_URL=postgresql://cadebit:cadebit@127.0.0.1:5432/cadebit

# Shared secret for calls from the web server. Use the same value in apps/web.
AI_SERVICE_TOKEN=cadebit-local-ai-service-token

# OpenAI Responses API configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1200
